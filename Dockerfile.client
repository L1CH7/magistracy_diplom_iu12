# syntax=docker/dockerfile:1.7-labs
# Dockerfile for Navigation MAS Client

FROM python:3.11

# For GPU/X11 mode install QtWebEngine runtime libs (Debian/Ubuntu):
RUN --mount=type=cache,target=/var/cache/apt \
	apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
	libgl1 \
	libx11-6 libxext6 libx11-xcb1 libxfixes3 \
	libxcomposite1 libxrender1 libxdamage1 libxrandr2 \
	libxi6 libxtst6 libxshmfence1 libxss1 \
	libxcb1 libxcb-render0 libxcb-shape0 libxcb-shm0 libxcursor1 \
	libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
	libxcb-xfixes0 libxcb-xinerama0 libxcb-xkb1 libxcb-sync1 libxcb-util1 \
	libdrm2 libgbm1 \
	libglib2.0-0 libdbus-1-3 \
	libnss3 libasound2 libxkbcommon0 libxkbcommon-x11-0 \
	libsm6 libice6 libfontconfig1 libfreetype6 libjpeg62-turbo \
	libegl1 \
	fonts-dejavu-core \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
	pip install --no-compile -r requirements.txt

COPY src/ ./src/
COPY src/client/assets/ ./src/client/assets/

# Default run (X11 host display expected; use compose volumes to pass /tmp/.X11-unix):
CMD ["python", "src/client/main.py"]